# Copy to apps/demo/.env.local for local development. Never commit real values.
#
# LastTouch relying party settings. Passkeys are tied to the rpID (a domain).
# Leave these unset to derive them automatically:
#   - on Vercel, from VERCEL_BRANCH_URL / VERCEL_URL
#   - locally, fall back to localhost / http://localhost:3000
LASTTOUCH_RP_ID=
LASTTOUCH_ORIGIN=
LASTTOUCH_RP_NAME="Nightjar Live"
